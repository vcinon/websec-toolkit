# Copy to .env and adjust. Values are read by config.py via the environment.
# Load them with:  set -a && source .env && set +a

# Flask session / CSRF signing key — set a long random value in any shared setup.
SECRET_KEY=change-me-to-a-long-random-value

# Where the SQLite database, scan output and logs are written.
WST_INSTANCE_DIR=./instance
WST_SCAN_DIR=./instance/scans

# Independent wordlist libraries (never shared between tools).
WST_FFUF_WORDLIST_DIR=./wordlists/ffuf
WST_KATANA_WORDLIST_DIR=./wordlists/katana

# Upload limit for wordlists, in bytes (default 32 MB).
WST_MAX_UPLOAD_BYTES=33554432

# Development server.
WST_HOST=127.0.0.1
WST_PORT=5000
WST_DEBUG=0
